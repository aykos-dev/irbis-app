{
  "name": "irbis-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --mode devDebug --appId uz.irbis.app.dev",
    "android:staging": "react-native run-android --mode stagingDebug --appId uz.irbis.app.staging",
    "android:apk": "node scripts/serve-apk.js release",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "lint": "eslint . --quiet --no-inline-config",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "jest",
    "test:ci": "jest --silent --reporters=summary",
    "slop": "! grep -rnE 'TODO|FIXME|@ts-ignore|eslint-disable|\\bmock' src --include='*.ts' --include='*.tsx' --exclude-dir=__tests__ --exclude='*.spec.*' --exclude='*.test.*' --exclude-dir=generated && ! grep -rn \"from 'expo\" src",
    "check": "npm run -s lint && npm run -s typecheck && npm run -s test:ci && npm run -s slop",
    "gen:api": "orval --config orval.config.ts && tsc --noEmit --pretty false",
    "assets:link": "react-native-asset"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "5.2.14",
    "@maplibre/maplibre-react-native": "11.5.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@tanstack/react-query": "5.104.3",
    "axios": "1.20.0",
    "i18n-js": "4.5.4",
    "lottie-react-native": "7.5.0",
    "react": "19.3.0",
    "react-hook-form": "7.90.0",
    "react-native": "0.88.0",
    "react-native-audio-api": "0.13.6",
    "react-native-config": "1.7.2",
    "react-native-device-info": "15.0.2",
    "react-native-gesture-handler": "3.4.0",
    "react-native-haptic-feedback": "3.0.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-keychain": "10.0.0",
    "react-native-localize": "3.7.2",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-qrcode-svg": "6.3.26",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-tcp-socket": "6.4.3",
    "react-native-vision-camera": "4.7.3",
    "react-native-wifi-reborn": "4.13.6",
    "react-native-worklets": "0.13.0",
    "react-native-zeroconf": "0.17.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-export-namespace-from": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.10",
    "@eslint/js": "10.0.1",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "orval": "8.43.0",
    "prettier": "3.9.10",
    "qrcode-terminal": "0.12.0",
    "react-native-asset": "2.3.0",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
